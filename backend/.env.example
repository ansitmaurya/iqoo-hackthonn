# Flask Environment
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=traceguard-super-secret-key-change-in-production

# Supabase PostgreSQL Database URI
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Or Transaction Pooler: postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres

# Local fallback: leave empty or set to sqlite:///traceguard.db for instant zero-config testing
SQLITE_FALLBACK=true

# CORS Configuration (comma-separated origins allowed to talk to backend)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Port
PORT=5000
