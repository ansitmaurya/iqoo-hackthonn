# Flask Environment Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=traceguard-super-secret-key-change-in-production

# Supabase PostgreSQL Database Connection URL
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

# Local SQLite Fallback (used when DATABASE_URL is empty for zero-config offline testing)
SQLITE_FALLBACK=true

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000

# Server Port
PORT=5000
